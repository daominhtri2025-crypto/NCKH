# Sao chép thành api/.env rồi điền giá trị. Không commit tệp .env thật.

# Môi trường: local (máy cá nhân, cho phép tạo tài khoản mặc định) hoặc production (hosting).
# TRÊN HOSTING PHẢI ĐẶT production. Lệnh seed_local.php sẽ từ chối chạy ngoài local.
APP_ENV=local

APP_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=antoanso_dev
DB_USER=antoanso
DB_PASS=change_me

# Kiểm thử: DB_NAME phải kết thúc bằng _test (bộ kiểm thử xóa sạch dữ liệu).

# Xuất dữ liệu nghiên cứu qua HTTP (GET /api/admin/export/*.csv, header X-Admin-Token).
# Để trống để tắt chức năng này. Dùng chuỗi ngẫu nhiên dài, không chia sẻ qua kênh không an toàn.
ADMIN_TOKEN=

# Số ngày tối thiểu từ khi hoàn thành khảo sát sau can thiệp đến khi mở khảo sát theo dõi (mặc định 28 = 4 tuần).
DELAYED_MIN_DAYS=28

# Tổng số thẻ tối đa mỗi lớp (kể cả thẻ giáo viên tự tạo).
CLASS_CARD_LIMIT=300
